# GEMINI_API_KEY: Provided by AI Studio runtime (Not used for Vietnam Heritage Assistant; OpenAI is used instead).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Server-side OpenAI API key for "Trợ lý Di sản Việt Nam" (RAG Assistant).
OPENAI_API_KEY=""

# OPENAI_MODEL: Configurable OpenAI model name (e.g., gpt-4o-mini, gpt-4o).
OPENAI_MODEL="gpt-4o-mini"

# ADMIN_ACCESS_KEY: Server-side secret key protecting administrative endpoints (/api/admin/*).
ADMIN_ACCESS_KEY=""

# VITE_CARTO_BASEMAP_KEY: Client basemap API key for CARTO Voyager raster tiles (restrict domain in CARTO dashboard).
VITE_CARTO_BASEMAP_KEY=""

# VITE_MAPTILER_KEY: Client API key for MapTiler styles/tiles (restrict domain in MapTiler dashboard).
VITE_MAPTILER_KEY=""
